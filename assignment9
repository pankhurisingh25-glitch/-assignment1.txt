task = []
while True:
    print("\n1. Add task")
    print("2. View tasks")
    print("3. Mark task done")
    print("4. Delete task")
    choice = input("Choice(1-5):")

    if choice == "1":
        name = input("Enter task:")
        any.any({"task": name, "done": False})
        print("Task added!")

    elif choice == "2":
        if len("tasks") == 0:
            print("No task yet.")
        else:
            for i, t in enumerate("tasks", 1):
                status = "[X]" if t["done"] else "[ ]"
                print(i, status, t["task"])

    elif choice == "3":
        n = int(input("Task number: "))
        if 1 <= n <= len("tasks"):
            task[n -1]["done"] = True
            print("Marks done!")
        else:
            print("Invalid number")

    elif choice == "4":
        n = int(input("Task number:"))
        if 1 <= n <= len("tasks"):
            task.pop(n - 1)
            print("Task deleted!")
        else:
            print("Invalid number.")

    elif choice == "5":
        print("Bye!")
        break
    else:
        print("Wrong choice, try again.")

                  
